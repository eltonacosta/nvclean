#!/bin/bash
# ============================================================================
# AppRun — ponto de entrada do AppImage do nvclean.
#
# O AppImage é somente-leitura e monta em /tmp/.mount_*/ que desaparece ao
# fechar. O filtro do PipeWire, porém, carrega o plugin LADSPA por caminho
# ABSOLUTO e continua rodando depois que a GUI fecha. Por isso o AppRun copia
# o que precisa ser persistente para ~/.local e aponta a config do PipeWire
# para lá — o AppImage só precisa existir no momento da instalação.
#
# Nada aqui usa root. Nada aqui toca a saída de áudio do sistema.
#
# Uso:
#   ./nvclean.AppImage                 abre a GUI (instala na primeira vez)
#   ./nvclean.AppImage --install       instala/atualiza e sai
#   ./nvclean.AppImage --uninstall     remove instalação do usuário
#   ./nvclean.AppImage --check         diagnóstico do ambiente
#   ./nvclean.AppImage --toggle        liga/desliga o filtro e sai
#   ./nvclean.AppImage --cli ...       repassa para o nvclean-control
# ============================================================================
set -uo pipefail

APPDIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export APPDIR

BIN_DIR="$HOME/.local/bin"
LADSPA_DIR="$HOME/.local/lib/ladspa"
PW_CONF_DIR="$HOME/.config/pipewire/pipewire.conf.d"
APPS_DIR="$HOME/.local/share/applications"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/nvclean"
CONF_DST="$PW_CONF_DIR/60-nvclean.conf"
PLUGIN_DST="$LADSPA_DIR/nvclean_rnnoise_stereo.so"

PLUGIN_SRC="$APPDIR/usr/lib/nvclean/nvclean_rnnoise_stereo.so"
CONF_SRC="$APPDIR/usr/share/nvclean/filter-chain-nvclean.conf"
CONTROL_SRC="$APPDIR/usr/share/nvclean/nvclean-control"
APP_SRC="$APPDIR/usr/share/nvclean/nvclean-app"
DESKTOP_SRC="$APPDIR/usr/share/applications/nvclean.desktop"
ICON_SRC="$APPDIR/nvclean.png"

say()  { printf '\033[1;32m==\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m!\033[0m %s\n' "$*" >&2; }
die()  { printf '\033[1;31mx\033[0m %s\n' "$*" >&2; exit 1; }

# ---------------------------------------------------------------------------
# Dependências
# ---------------------------------------------------------------------------
check_deps() {
  local missing=0
  for cmd in pw-dump pw-cli pw-link pw-cat; do
    if ! command -v "$cmd" >/dev/null 2>&1; then
      warn "faltando: $cmd (instale pipewire)"
      missing=1
    fi
  done
  if ! python3 -c "import gi; gi.require_version('Gtk','3.0')" >/dev/null 2>&1; then
    warn "faltando PyGObject + GTK 3 (Arch: python-gobject gtk3 | Debian: python3-gi gir1.2-gtk-3.0)"
    missing=1
  fi
  # Sem typelib do Dbusmenu o ícone de bandeja não existe no Wayland (o
  # Gtk.StatusIcon legado não é exibido). Não é fatal: o app abre a janela e
  # avisa, mas o menu da bandeja fica sem opções.
  if ! python3 -c "import gi; gi.require_version('Dbusmenu','0.4')" >/dev/null 2>&1; then
    warn "faltando gir1.2-dbusmenu-0.4 (Arch: libdbusmenu-glib | Debian: gir1.2-dbusmenu-0.4) — menu da bandeja indisponível"
  fi
  [ "$missing" = "0" ] || return 1
  return 0
}

# ---------------------------------------------------------------------------
# Instalação (idempotente)
# ---------------------------------------------------------------------------
install_all() {
  [ -f "$PLUGIN_SRC" ] || die "plugin ausente dentro do AppImage: $PLUGIN_SRC"
  [ -f "$CONF_SRC" ]   || die "config ausente dentro do AppImage: $CONF_SRC"

  mkdir -p "$BIN_DIR" "$LADSPA_DIR" "$PW_CONF_DIR" "$APPS_DIR"

  local first_time=0
  [ -f "$CONF_DST" ] || first_time=1

  # plugin: copiar só se mudou (preserva mtime e evita reinstalação inútil)
  if ! cmp -s "$PLUGIN_SRC" "$PLUGIN_DST"; then
    install -m644 "$PLUGIN_SRC" "$PLUGIN_DST.tmp" && mv -f "$PLUGIN_DST.tmp" "$PLUGIN_DST"
  fi

  # config do filter-chain aponta para o caminho persistente
  if ! cmp -s <(sed "s|@PLUGIN_PATH@|$PLUGIN_DST|" "$CONF_SRC") "$CONF_DST" 2>/dev/null; then
    sed "s|@PLUGIN_PATH@|$PLUGIN_DST|" "$CONF_SRC" > "$CONF_DST.tmp" \
      && mv -f "$CONF_DST.tmp" "$CONF_DST"
    # config mudou: o PipeWire precisa reler
    if systemctl --user is-active pipewire >/dev/null 2>&1; then
      say "recarregando o PipeWire para aplicar a configuração"
      systemctl --user restart pipewire >/dev/null 2>&1 || true
      sleep 2
    fi
  fi

  # controlador, GUI e guardião do link
  install -m755 "$CONTROL_SRC" "$BIN_DIR/nvclean-control"
  install -m755 "$APP_SRC" "$BIN_DIR/nvclean-app"
  if [ -f "$APPDIR/usr/share/nvclean/nvclean-reconnect" ]; then
    install -m755 "$APPDIR/usr/share/nvclean/nvclean-reconnect" "$BIN_DIR/nvclean-reconnect"
  fi

  # atalho e ícone no menu.
  # Exec= precisa de aspas: $HOME pode ter espaço ("Área de trabalho") e um
  # Exec sem aspas gera .desktop inválido (o GIO rejeita e o item não abre).
  # `%` é field code do Exec; sem forma válida de escapar, avisa e segue.
  mkdir -p "$HOME/.local/share/icons/hicolor/256x256/apps"
  install -m644 "$ICON_SRC" "$HOME/.local/share/icons/hicolor/256x256/apps/nvclean.png"
  if printf '%s' "$BIN_DIR/nvclean-app" | grep -q '%'; then
    warn "caminho contém '%': o atalho do menu pode não abrir (limitação do .desktop)"
  fi
  desktop_quote() {
    # aspas duplas do Exec + escape do GKeyFile para \ " ` $
    local p="$1"
    p="${p//\\/\\\\}"
    p="${p//\"/\\\\\"}"
    p="${p//\`/\\\`}"
    p="${p//\$/\\\$}"
    printf '"%s"' "$p"
  }
  sed -e "s|^Exec=.*|Exec=$(desktop_quote "$BIN_DIR/nvclean-app")|" \
      -e "s|^Icon=.*|Icon=$(desktop_quote "$HOME/.local/share/icons/hicolor/256x256/apps/nvclean.png")|" \
      "$DESKTOP_SRC" > "$APPS_DIR/nvclean.desktop"

  # serviço que mantém o microfone ligado entre reinícios do PipeWire
  if [ -f "$APPDIR/usr/share/nvclean/nvclean-reconnect.service" ]; then
    mkdir -p "$HOME/.config/systemd/user"
    install -m644 "$APPDIR/usr/share/nvclean/nvclean-reconnect.service" \
      "$HOME/.config/systemd/user/nvclean-reconnect.service"
    systemctl --user daemon-reload >/dev/null 2>&1 || true
    systemctl --user enable --now nvclean-reconnect >/dev/null 2>&1 || true
    # dá tempo do serviço subir antes de tentar conectar
    sleep 1
  fi

  # conecta um microfone utilizável: salvo -> padrão -> qualquer um.
  # Repete por até ~15 s: depois de reiniciar o PipeWire o dispositivo pode
  # demorar a expor as portas.
  if [ -x "$BIN_DIR/nvclean-control" ]; then
    connected=0
    for attempt in 1 2 3 4 5; do
      if [ -n "$("$BIN_DIR/nvclean-control" status --json 2>/dev/null | \
                python3 -c 'import json,sys; print(json.load(sys.stdin).get("mic") or "")' 2>/dev/null)" ]; then
        connected=1
        break
      fi

      # 1. microfone salvo (reconnect usa ~/.config/nvclean/mic)
      "$BIN_DIR/nvclean-control" reconnect >/dev/null 2>&1 && {
        connected=1; break; }

      # 2. microfone padrão do sistema
      default_mic="$(pactl get-default-source 2>/dev/null || true)"
      [ -n "$default_mic" ] && "$BIN_DIR/nvclean-control" mic "$default_mic" >/dev/null 2>&1

      # 3. qualquer microfone listado
      while IFS=$'\t' read -r name _desc; do
        name="${name#\* }"; name="${name# }"
        [ -n "$name" ] || continue
        "$BIN_DIR/nvclean-control" mic "$name" >/dev/null 2>&1 && break
      done < <("$BIN_DIR/nvclean-control" mics 2>/dev/null || true)

      if [ -n "$("$BIN_DIR/nvclean-control" status --json 2>/dev/null | \
                python3 -c 'import json,sys; print(json.load(sys.stdin).get("mic") or "")' 2>/dev/null)" ]; then
        connected=1
        break
      fi
      sleep 2
    done

    # liga o filtro apenas na primeira instalação; depois respeita a escolha
    if [ "$first_time" = "1" ]; then
      "$BIN_DIR/nvclean-control" on >/dev/null 2>&1 || true
    fi

    [ "$connected" = "1" ] || warn "nenhum microfone conectado — use: nvclean-control mic <nome>"
  fi
}

uninstall_all() {
  say "removendo instalação do usuário"
  # devolve o microfone padrão ao sistema antes de sumir com o filtro
  if [ -x "$BIN_DIR/nvclean-control" ]; then
    "$BIN_DIR/nvclean-control" off >/dev/null 2>&1 || true
  fi
  systemctl --user disable --now nvclean-reconnect >/dev/null 2>&1 || true
  rm -f "$HOME/.config/systemd/user/nvclean-reconnect.service"
  systemctl --user daemon-reload >/dev/null 2>&1 || true

  rm -f "$CONF_DST" "$PLUGIN_DST" \
        "$BIN_DIR/nvclean-control" "$BIN_DIR/nvclean-app" "$BIN_DIR/nvclean-reconnect" \
        "$APPS_DIR/nvclean.desktop" \
        "$HOME/.local/share/icons/hicolor/256x256/apps/nvclean.png" \
        "$HOME/.config/autostart/nvclean.desktop"
  # remove o estado do app, mas preserva o baseline de escopo (é um registro
  # de referência da saída do sistema, não configuração do nvclean)
  rm -f "$STATE_DIR/last-intensity" "$HOME/.config/nvclean/mic"
  if systemctl --user is-active pipewire >/dev/null 2>&1; then
    systemctl --user restart pipewire >/dev/null 2>&1 || true
  fi
  echo "removido."
}

# ---------------------------------------------------------------------------
# Dispatch
# ---------------------------------------------------------------------------
case "${1:-}" in
  --install)
    check_deps || die "dependências ausentes"
    say "instalando nvclean"
    install_all
    "$BIN_DIR/nvclean-control" doctor
    echo
    echo "Instalado. Abra com: nvclean-app   (ou o próprio AppImage)"
    exit 0
    ;;
  --uninstall)
    uninstall_all
    exit 0
    ;;
  --check)
    check_deps || true
    if [ -x "$BIN_DIR/nvclean-control" ]; then
      "$BIN_DIR/nvclean-control" doctor
      exit $?
    fi
    echo "nvclean ainda não instalado (rode com --install)"
    exit 1
    ;;
  --toggle)
    if [ -x "$BIN_DIR/nvclean-control" ]; then
      exec "$BIN_DIR/nvclean-control" toggle
    fi
    die "nvclean não instalado (rode com --install)"
    ;;
  --cli)
    shift
    if [ -x "$BIN_DIR/nvclean-control" ]; then
      exec "$BIN_DIR/nvclean-control" "$@"
    fi
    die "nvclean não instalado (rode com --install)"
    ;;
esac

# execução normal: garante instalação e abre a GUI
check_deps || die "instale as dependências acima e tente de novo"

if [ ! -x "$BIN_DIR/nvclean-app" ] || [ ! -f "$PLUGIN_DST" ] || [ ! -f "$CONF_DST" ]; then
  say "primeira execução — instalando"
  install_all
fi

exec "$BIN_DIR/nvclean-app" "$@"
