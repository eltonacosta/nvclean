def control(*args: str) -> tuple[int, str]:
    """Executa o controlador e devolve (código, saída). Bloqueia o chamador."""
    if not os.path.isfile(CONTROL):
        return 1, f"controlador não encontrado: {CONTROL}"
    cmd = [CONTROL, *args] if os.access(CONTROL, os.X_OK) else [sys.executable, CONTROL, *args]
    try:
        proc = subprocess.run(
            cmd, capture_output=True, text=True, timeout=20,
        )
        return proc.returncode, (proc.stdout or proc.stderr).strip()
    except subprocess.TimeoutExpired:
        return 1, "timeout"
    except OSError as exc:
        return 1, f"falha ao executar {CONTROL}: {exc}"


def control_json(*args: str) -> dict:
    """Lê um payload JSON do controlador.

    O `status --json` usa o código de saída para indicar saúde: 0 = tudo ok,
    3 = filtro/nó sem microfone conectado. O corpo JSON vem completo nos dois
    casos, então o código NÃO pode ser tratado como "sem payload" — era o que
    matava o caminho de reconexão justamente quando o microfone caía.
    """
    code, out = control(*args, "--json")
    if code not in (0, 3):
        return {}
    # `control` devolve stdout ou stderr; descarta linhas de aviso antes do JSON.
    for line in reversed(out.splitlines()):
        line = line.strip()
        if line.startswith("{"):
            try:
                return json.loads(line)
            except json.JSONDecodeError:
                return {}
    return {}


