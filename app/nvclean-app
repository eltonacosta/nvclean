        <method name="Activate">
          <arg name="x" type="i" direction="in"/>
          <arg name="y" type="i" direction="in"/>
        </method>
        <method name="ProvideXdgActivationToken">
          <arg name="token" type="s" direction="in"/>
        </method>
        <method name="SecondaryActivate">
          <arg name="x" type="i" direction="in"/>
          <arg name="y" type="i" direction="in"/>
        </method>
        <method name="XAyatanaSecondaryActivate">
          <arg name="timestamp" type="u" direction="in"/>
        </method>
        <method name="Scroll">
          <arg name="delta" type="i" direction="in"/>
          <arg name="orientation" type="s" direction="in"/>
        </method>
        <signal name="NewStatus">
          <arg name="status" type="s"/>
        </signal>
        <signal name="NewIcon"/>
        <signal name="NewToolTip"/>
      </interface>
    </node>
    """

    class SystemTray:
        """Ícone de bandeja com menu Abrir / Configurações / Sair.

        Prioriza StatusNotifierItem (Wayland, GNOME, KDE). Se não houver
        watcher nem D-Bus, cai para Gtk.StatusIcon (X11/XEmbed).
        """

        MENU_PATH = "/org/nvclean/Menu"
        SNI_PATH = "/StatusNotifierItem"
        BUS_NAME = "org.nvclean.App"

        def __init__(self, app, icon_name: str) -> None:
            self.app = app
            self.icon_name = icon_name
            self._conn = None
            self._sni = None
            self._dbusmenu = None
            self._status_icon = None
            self._toggle_item = None
            self._last_click = 0.0
            self.available = False

        # -- construção -------------------------------------------------
        def build(self) -> bool:
            self.error = ""
            if self._build_sni():
                self.available = True
                self.update_state(self.app.enabled)
                return True
            self._build_status_icon()
            icon_ok = False
            if self._status_icon is not None:
                try:
                    # No Wayland o XEmbed não é exibido: is_embedded fica False
                    # e não há ícone nenhum. Melhor saber agora para avisar.
                    icon_ok = bool(self._status_icon.is_embedded())
                except Exception:
                    icon_ok = True
            self.available = icon_ok
            return self.available

        def _build_menu(self) -> None:
            """Cria o menu D-Bus (libdbusmenu-glib)."""
            gi_menu = __import__("gi")
            gi_menu.require_version("Dbusmenu", "0.4")
            from gi.repository import Dbusmenu

            root = Dbusmenu.Menuitem.new()

            toggle = Dbusmenu.Menuitem.new()
            toggle.property_set(Dbusmenu.MENUITEM_PROP_LABEL, "Cancelamento de ruído")
            toggle.property_set(Dbusmenu.MENUITEM_PROP_TOGGLE_TYPE, "checkmark")
            toggle.property_set_int(Dbusmenu.MENUITEM_PROP_TOGGLE_STATE,
                                    1 if self.app.enabled else 0)
            toggle.connect("item-activated", self._on_toggle_activated)
            root.child_append(toggle)
            self._toggle_item = toggle

            sep = Dbusmenu.Menuitem.new()
            sep.property_set(Dbusmenu.MENUITEM_PROP_TYPE, "separator")
            root.child_append(sep)

            for label, handler in (
                ("Abrir", lambda *_: self.app.show_window()),
                ("Configurações", lambda *_: self.app.open_settings()),
            ):
                item = Dbusmenu.Menuitem.new()
                item.property_set(Dbusmenu.MENUITEM_PROP_LABEL, label)
                item.connect("item-activated", self._make_handler(handler))
                root.child_append(item)

            sep2 = Dbusmenu.Menuitem.new()
            sep2.property_set(Dbusmenu.MENUITEM_PROP_TYPE, "separator")
            root.child_append(sep2)

            quit_item = Dbusmenu.Menuitem.new()
            quit_item.property_set(Dbusmenu.MENUITEM_PROP_LABEL, "Sair (fechar de vez)")
            quit_item.connect("item-activated", self._make_handler(lambda *_: self.app.quit()))
            root.child_append(quit_item)

            server = Dbusmenu.Server.new(self.MENU_PATH)
            server.set_root(root)
            self._dbusmenu = (server, root)

        @staticmethod
        def _make_handler(fn):
            from gi.repository import Dbusmenu

            def handler(_item, _timestamp):
                fn()
                return Dbusmenu.MENUITEM_EVENT_ACTIVATED

            return handler

        def _on_toggle_activated(self, _item, _timestamp):
            from gi.repository import Dbusmenu

            # Não confia no cache local: o filtro pode ter sido alterado por
            # fora (CLI, atalho, outro app). O controlador lê o mix real e
            # alterna a partir dele; o refresh corrige o desenho do check.
            self.app.toggle_from_tray(None)
            return Dbusmenu.MENUITEM_EVENT_ACTIVATED

        def _build_sni(self) -> bool:
            try:
                from gi.repository import Gio, GLib
            except ImportError:
                return False

            try:
                conn = Gio.bus_get_sync(Gio.BusType.SESSION, None)
            except GLib.Error:
                return False
            if conn is None:
                return False

            try:
                self._build_menu()
            except (ImportError, ValueError) as exc:
                # libdbusmenu-glib ausente: gi.require_version levanta
                # ValueError, não ImportError. Sem menu não há SNI útil; o
                # motivo fica visível no aviso de "sem bandeja".
                self.error = f"menu da bandeja indisponível ({exc})"
                return False
            except Exception:
                self.error = "falha ao montar o menu da bandeja"
                return False

            try:
                node = Gio.DBusNodeInfo.new_for_xml(SNI_INTERFACE).interfaces[0]
            except GLib.Error:
                return False

            properties = {
                "Category": GLib.Variant("s", "ApplicationStatus"),
                "Id": GLib.Variant("s", "nvclean"),
                "Title": GLib.Variant("s", "nvclean — microfone"),
                "Status": GLib.Variant("s", "Active"),
                "WindowId": GLib.Variant("i", 0),
                "IconThemePath": GLib.Variant("s", ""),
                "Menu": GLib.Variant("o", self.MENU_PATH),
                # ItemIsMenu=False: clique simples abre a janela (Activate) e o
                # menu abre no botão direito. Com True o clique simples abriria
                # o menu, e o duplo clique não teria como abrir a janela.
                "ItemIsMenu": GLib.Variant("b", False),
                "IconName": GLib.Variant("s", self.icon_name),
                "OverlayIconName": GLib.Variant("s", ""),
                "AttentionIconName": GLib.Variant("s", ""),
                "AttentionMovieName": GLib.Variant("s", ""),
            }

            def on_method(_conn, _sender, _path, _iface, method, _params, invocation):
                if method in ("Activate", "SecondaryActivate"):
                    GLib.idle_add(self.app.show_window)
                elif method == "ContextMenu":
                    GLib.idle_add(self.app.show_window)
                invocation.return_value(None)

            def on_get(_conn, _sender, _path, _iface, prop):
                return properties.get(prop)

            try:
                self._sni = conn.register_object(
                    self.SNI_PATH, node, on_method, on_get, None
                )
            except (GLib.Error, TypeError):
                return False
            if not self._sni:
                return False

            try:
                Gio.bus_own_name_on_connection(
                    conn, self.BUS_NAME, Gio.BusNameOwnerFlags.NONE, None, None
                )
            except GLib.Error:
                pass

            self._conn = conn
            # O host da bandeja pode ainda não existir quando o app sobe no
            # login (corrida com o shell). Tenta algumas vezes, em vez de
            # registrar uma única vez e perder o ícone da sessão inteira.
            self._register_attempts = 0
            GLib.timeout_add(300, self._register_with_watcher)
            return True

        def _register_with_watcher(self) -> bool:
            from gi.repository import Gio, GLib

            self._register_attempts = getattr(self, "_register_attempts", 0) + 1
            for service in (self.BUS_NAME, self.SNI_PATH):
                try:
                    self._conn.call_sync(
                        "org.kde.StatusNotifierWatcher",
                        "/StatusNotifierWatcher",
                        "org.kde.StatusNotifierWatcher",
                        "RegisterStatusNotifierItem",
                        GLib.Variant("(s)", (service,)),
                        None,
                        Gio.DBusCallFlags.NONE,
                        1500,
                        None,
                    )
                    self.registered = True
                    return False
                except GLib.Error:
                    continue
            # 19 tentativas × 300 ms ≈ 6 s. Sem watcher
            # (GNOME puro, sem a extensão AppIndicator) o ícone nunca aparece:
            # nesse caso o app precisa se declarar sem bandeja para a janela
            # não ficar invisível no autostart.
            if self._register_attempts >= 19:
                self.registered = False
                self.available = False
                self.error = "nenhum host de bandeja (StatusNotifierWatcher) na sessão"
                self.app.on_tray_unavailable()
                return False
            return True

        def is_registered(self) -> bool:
            return bool(getattr(self, "registered", False))

        def _build_status_icon(self) -> None:
            try:
                from gi.repository import Gtk

                icon = Gtk.StatusIcon()
                icon.set_from_icon_name(self.icon_name)
                icon.set_tooltip_text("nvclean — microfone")
                icon.connect("activate", self._on_status_activate)
                icon.connect("popup-menu", self._on_status_menu)
                icon.set_visible(True)
                self._status_icon = icon
            except Exception:
                self._status_icon = None

        # -- eventos do fallback X11 -------------------------------------
        def _on_status_activate(self, _icon) -> None:
            """Duplo clique abre a janela; clique simples alterna a visibilidade."""
            import time

            now = time.monotonic()
            if now - self._last_click < 0.45:
                self._last_click = 0.0
                self.app.show_window()
                return
            self._last_click = now
            self.app.toggle_window()

        def _on_status_menu(self, icon, button, time) -> None:
            from gi.repository import Gtk

            menu = Gtk.Menu()
            toggle = Gtk.CheckMenuItem(label="Cancelamento de ruído")
            toggle.set_active(self.app.enabled)
            toggle.connect("toggled", lambda w: self.app.toggle_from_tray(w.get_active()))
            menu.append(toggle)
            menu.append(Gtk.SeparatorMenuItem())
            open_item = Gtk.MenuItem(label="Abrir")
            open_item.connect("activate", lambda *_: self.app.show_window())
            menu.append(open_item)
            settings_item = Gtk.MenuItem(label="Configurações")
            settings_item.connect("activate", lambda *_: self.app.open_settings())
            menu.append(settings_item)
            menu.append(Gtk.SeparatorMenuItem())
            quit_item = Gtk.MenuItem(label="Sair (fechar de vez)")
            quit_item.connect("activate", lambda *_: self.app.quit())
            menu.append(quit_item)
            menu.show_all()
            menu.popup(None, None, None, None, button, time)

        # -- atualização de estado --------------------------------------
        def update_state(self, enabled: bool) -> None:
            if self._toggle_item is not None:
                try:
                    from gi.repository import Dbusmenu

                    self._toggle_item.property_set_int(
                        Dbusmenu.MENUITEM_PROP_TOGGLE_STATE, 1 if enabled else 0
                    )
                except Exception:
                    pass
            if self._status_icon is not None:
                try:
                    self._status_icon.set_tooltip_text(
                        "nvclean — " + ("ligado" if enabled else "desligado")
                    )
                except Exception:
                    pass


