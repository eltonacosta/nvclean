    class IntSlider(Gtk.DrawingArea):
        """Slider de intensidade com o knob exatamente sob o cursor.

        O Gtk.Scale nativo posiciona o knob pela caixa do gadget do tema e o
        warp do clique é calculado como uma média entre as bordas do knob
        (gtkrange.c: coord_to_value + gtk_range_compute_slider_position).
        Com um knob maior que o padrão isso desloca o desenho para a direita
        do clique — a queixa do usuário. Aqui o mapeamento é direto:
        centro do knob == posição do cursor, sem folga.
        """

        __gsignals__ = {
            "value-changed": (GObject.SignalFlags.RUN_FIRST, None, (float,)),
        }

        PAD = 12  # raio do knob + folga, para o círculo não ser cortado

        def __init__(self) -> None:
            super().__init__()
            self._value = 1.0
            self._dragging = False
            self.set_size_request(-1, 30)
            self.set_can_focus(True)
            self.add_events(
                Gdk.EventMask.BUTTON_PRESS_MASK
                | Gdk.EventMask.BUTTON_RELEASE_MASK
                | Gdk.EventMask.POINTER_MOTION_MASK
                | Gdk.EventMask.KEY_PRESS_MASK
            )
            self.connect("draw", self._on_draw)
            self.connect("button-press-event", self._on_press)
            self.connect("button-release-event", self._on_release)
            self.connect("motion-notify-event", self._on_motion)
            self.connect("key-press-event", self._on_key)

        # -- API ---------------------------------------------------------
        def get_value(self) -> float:
            return self._value

        def set_value(self, value: float) -> None:
            value = max(0.0, min(1.0, float(value)))
            if abs(value - self._value) < 1e-9:
                self._value = value
                self.queue_draw()
                return
            self._value = value
            self.queue_draw()
            self.emit("value-changed", value)

        # -- geometria ---------------------------------------------------
        def _track(self) -> tuple[float, float]:
            width = self.get_allocated_width()
            return self.PAD, max(self.PAD, width - self.PAD)

        def _value_at(self, x: float) -> float:
            left, right = self._track()
            if right <= left:
                return self._value
            return max(0.0, min(1.0, (x - left) / (right - left)))

        # -- desenho -----------------------------------------------------
        def _on_draw(self, _widget, cr) -> bool:
            width = self.get_allocated_width()
            height = self.get_allocated_height()
            left, right = self._track()
            cy = height / 2.0
            knob_x = left + self._value * (right - left)

            cr.set_line_cap(1)  # cairo.LINE_CAP_ROUND
            # trilho
            cr.set_source_rgb(0x2a / 255, 0x34 / 255, 0x41 / 255)
            cr.set_line_width(5)
            cr.move_to(left, cy)
            cr.line_to(right, cy)
            cr.stroke()
            # parte ativa
            cr.set_source_rgb(0x76 / 255, 0xb9 / 255, 0x00 / 255)
            cr.move_to(left, cy)
            cr.line_to(knob_x, cy)
            cr.stroke()
            # knob: anel branco + miolo verde, centrado no valor
            cr.set_source_rgb(1, 1, 1)
            cr.arc(knob_x, cy, 9, 0, 2 * 3.141592653589793)
            cr.fill()
            cr.set_source_rgb(0x76 / 255, 0xb9 / 255, 0x00 / 255)
            cr.arc(knob_x, cy, 6, 0, 2 * 3.141592653589793)
            cr.fill()
            return False

        # -- interação ---------------------------------------------------
        def _on_press(self, widget, event) -> bool:
            if event.button != 1:
                return False
            self._dragging = True
            self.grab_focus()
            self.set_value(self._value_at(event.x))
            return True

        def _on_release(self, _widget, event) -> bool:
            if event.button == 1:
                self._dragging = False
            return False

        def _on_motion(self, _widget, event) -> bool:
            if self._dragging and event.state & Gdk.ModifierType.BUTTON1_MASK:
                self.set_value(self._value_at(event.x))
                return True
            return False

        def _on_key(self, _widget, event) -> bool:
            step = 0.05
            if event.keyval in (Gdk.KEY_Left, Gdk.KEY_Down):
                self.set_value(self._value - step)
                return True
            if event.keyval in (Gdk.KEY_Right, Gdk.KEY_Up):
                self.set_value(self._value + step)
                return True
            return False

