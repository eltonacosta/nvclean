def load_settings() -> dict:
    settings = dict(DEFAULT_SETTINGS)
    try:
        with open(SETTINGS_PATH, encoding="utf-8") as fh:
            data = json.load(fh)
    except (OSError, json.JSONDecodeError):
        return settings
    if isinstance(data, dict):
        for key in DEFAULT_SETTINGS:
            if isinstance(data.get(key), bool):
                settings[key] = data[key]
    return settings


def save_settings(settings: dict) -> bool:
    """Grava as preferências de forma atômica (tmp + rename)."""
    try:
        os.makedirs(SETTINGS_DIR, exist_ok=True)
        tmp = SETTINGS_PATH + ".tmp"
        with open(tmp, "w", encoding="utf-8") as fh:
            json.dump(settings, fh, indent=2, sort_keys=True)
            fh.write("\n")
        os.replace(tmp, SETTINGS_PATH)
        return True
    except OSError:
        return False


def _desktop_exec_quote(path: str) -> str:
    """Escapa um argumento Exec= conforme a especificação Desktop Entry.

    Duas camadas de parser:
    1. GKeyFile lê o valor: só entende `\\s \\t \\n \\r \\\\`.
    2. Exec= divide o comando: dentro de aspas duplas, `"`, `` ` ``, `$` e
       `\\` precisam de barra invertida.

    Comportamento verificado no GIO desta máquina: espaço e `%` ficam
    literais (`%%` é REJEITADO); aspas pedem duas barras no arquivo; `$` e
    `` ` `` chegam ao argv com a barra intacta (limitação do GIO). Por isso
    `apply_autostart` valida o argv resultante e não publica um entry cujo
    Exec não aponte para o binário real.
    """
    escaped = path.replace("\\", "\\\\").replace('"', '\\\\"')
    escaped = escaped.replace("`", "\\`").replace("$", "\\$")
    return f'"{escaped}"'


def apply_autostart(enabled: bool) -> bool:
    """Cria/remove o .desktop de autostart. Devolve True se o disco bateu."""
    try:
        if enabled:
            os.makedirs(os.path.dirname(AUTOSTART_PATH), exist_ok=True)
            exec_path = shutil.which("nvclean-app") or os.path.abspath(sys.argv[0])
            if "%" in exec_path:
                # O GIO expande `%` do Exec como field code (`%20` vira "0") e
                # rejeita `%%`. Não existe forma válida para esse caminho, então
                # é melhor recusar do que publicar um autostart que não abre.
                return False
            tmp = AUTOSTART_PATH + ".tmp"
            with open(tmp, "w", encoding="utf-8") as fh:
                fh.write(AUTOSTART_ENTRY.format(exec_path=_desktop_exec_quote(exec_path)))
            # Valida antes de publicar: um Entry inválido (ou cujo Exec não
            # aponta para o binário) não inicia nada no login.
            if not _desktop_entry_valid(tmp, exec_path):
                os.remove(tmp)
                return False
            os.replace(tmp, AUTOSTART_PATH)
        elif os.path.exists(AUTOSTART_PATH):
            os.remove(AUTOSTART_PATH)
        return True
    except OSError:
        return False


def _desktop_entry_valid(path: str, expected_exec: str) -> bool:
    """Confere se o .desktop é aceito E se o Exec aponta para o binário real."""
    try:
        from gi.repository import Gio

        info = Gio.DesktopAppInfo.new_from_filename(path)
        if info is None:
            return False
        # Comparação exata do executável; `in` dava falso positivo para
        # ".../nvclean-app.wrapper" e não detectava `%20` virando `0`.
        # get_executable() devolve o token como está no Exec, com aspas.
        executable = (info.get_executable() or "").strip().strip('"')
        return os.path.realpath(executable) == os.path.realpath(expected_exec)
    except Exception:
        return False


def autostart_installed() -> bool:
    return os.path.exists(AUTOSTART_PATH)


