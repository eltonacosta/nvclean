        # ------------------------------------------------------------- bandeja
        def _build_tray(self) -> None:
            self.tray_controller = SystemTray(self, "audio-input-microphone")
            self.tray = self.tray_controller if self.tray_controller.build() else None

        def show_window(self) -> None:
            self.window.show_all()
            self.window.deiconify()
            self.window.present()

        def on_tray_unavailable(self) -> None:
            """Chamado quando a bandeja não pôde ser registrada.

            Iniciado com --hidden, o app ficaria sem janela e sem ícone; aqui
            ele se torna visível e explica o motivo.
            """
            if not self.tray_controller or self.tray_controller.is_registered():
                return
            self.tray = None
            self._no_tray_notice = (
                "Sem bandeja neste ambiente"
                + (f" ({self.tray_controller.error})" if self.tray_controller.error else "")
                + ". A janela fica aberta; use Configurações para sair."
            )
            self.hint.set_text(self._no_tray_notice)
            self.show_window()

        def toggle_window(self) -> None:
            if self.window.get_visible():
                self.window.hide()
            else:
                self.show_window()

        def toggle_from_tray(self, want: bool | None) -> None:
            """Toggle vindo da bandeja.

            `want=None` significa "alterna o estado real do servidor" e é o
            que o menu usa: ligar/desligar por fora (CLI, atalho) não pode
            deixar o clique da bandeja sem efeito.
            """
            if want is None:
                self._toggle_seq += 1
                seq = self._toggle_seq
                self._toggle_inflight += 1

                def work() -> None:
                    code, out = control("toggle")
                    GLib.idle_add(self._on_toggle_result, seq, code, out)

                threading.Thread(target=work, daemon=True).start()
                return
            self._syncing = True
            try:
                self.switch.set_active(want)
                self.switch.set_state(want)
            finally:
                self._syncing = False
            self._apply_enabled(want)

        def _on_toggle_result(self, seq: int, code: int, out: str) -> bool:
            self._toggle_inflight = max(0, self._toggle_inflight - 1)
            if seq != self._toggle_seq:
                return False
            if code != 0:
                self._show_hint(f"Falha ao alternar: {out}")
            # o status real (mix, enabled e intensidade) vem do servidor
            self.refresh_async(force_mics=False)
            return False

        # ------------------------------------------------------- ações async
        def _apply_enabled(self, want: bool) -> None:
            """Aplica o toggle em segundo plano; a UI responde na hora.

            Cada intenção recebe um número de sequência. Resultados de
            requisições antigas são descartados: sem isso, dois cliques rápidos
            podiam terminar na ordem inversa e deixar o servidor ligado com a
            interface mostrando desligado.
            """
            self._toggle_seq += 1
            seq = self._toggle_seq
            self._toggle_inflight += 1
            # feedback otimista: o widget já mudou, o servidor confirma depois
            self.enabled = want
            self._render_state()
            if self.tray:
                self.tray.update_state(want)

            def work() -> None:
                code, out = control("on" if want else "off")
                GLib.idle_add(self._on_enabled_result, seq, want, code, out)

            threading.Thread(target=work, daemon=True).start()

        def _on_enabled_result(self, seq: int, want: bool, code: int, out: str) -> bool:
            self._toggle_inflight = max(0, self._toggle_inflight - 1)
            # Uma intenção mais nova já foi enviada — este resultado é obsoleto.
            if seq != self._toggle_seq:
                return False
            if code != 0:
                self._show_hint(f"Falha: {out}")
                # reverte o feedback otimista para o estado real
                self.refresh_async(force_mics=False)
            else:
                # `on` aplica a intensidade salva, que pode diferir do slider
                # (ex.: usuário mexeu em outro cliente). Re-sincroniza para a
                # UI não mostrar 95% com o filtro rodando em outro valor.
                self._clear_sticky_hint()
                self.refresh_async(force_mics=False)
            return False

        def _on_toggle(self, switch, state: bool) -> bool:
            if self._syncing:
                return True
            # O GtkSwitch guarda 'active' (intenção) e 'state' (desenho). O
            # tema só pinta :checked quando state == active, e o GTK não faz
            # essa sincronização sozinho quando o handler controla o fluxo.
            # Sem o set_state abaixo o trilho fica cinza mesmo ligado.
            switch.set_state(state)
            self._apply_enabled(state)
            return False

        def _on_intensity(self, scale, value: float | None = None) -> None:
            if self._syncing:
                return
            value = round(scale.get_value() if value is None else value, 2)
            self.intensity_value.set_text(f"{int(value * 100)}%")
            if abs(value - self.intensity) < 0.005:
                return
            self.intensity = value
            self._queue_intensity(value)

        def _queue_intensity(self, value: float) -> None:
            """Coalesce mudanças do slider: grava no máximo a cada ~120 ms.

            Sem isso, cada pixel arrastado disparava um processo (~75 ms) e a
            interface engasgava.
            """
            self._pending_intensity = value
            if self._intensity_timer is None:
                self._intensity_timer = GLib.timeout_add(120, self._flush_intensity)

        def _flush_intensity(self) -> bool:
            self._intensity_timer = None
            value = self._pending_intensity
            self._pending_intensity = None
            if value is None:
                return False

            def work() -> None:
                code, out = control("intensity", str(value))
                if code != 0:
                    GLib.idle_add(self._show_hint, f"Falha na intensidade: {out}")

            threading.Thread(target=work, daemon=True).start()
            return False

        def _clear_sticky_hint(self) -> None:
            self._sticky_hint = ""

        def _show_hint(self, text: str) -> bool:
            # Erro/ação do usuário não pode ser apagado ~100 ms depois pelo
            # refresh de status. Fica "preso" até a próxima ação bem-sucedida.
            self._sticky_hint = text or ""
            self.hint.set_text(text)
            return False

        def _on_mic_changed(self, combo) -> None:
            # Ignora mudanças programáticas (popular lista / sincronizar).
            if self._syncing:
                return
            idx = combo.get_active()
            if idx < 0 or idx >= len(self.mics):
                return
            name, _desc = self.mics[idx]
            if name == self.mic:
                return
            self.mic = name

            def work() -> None:
                code, out = control("mic", name)
                GLib.idle_add(self._on_mic_result, name, code, out)

            threading.Thread(target=work, daemon=True).start()

        def _on_mic_result(self, name: str, code: int, out: str) -> bool:
            if code != 0:
                self._show_hint(f"Falha ao trocar microfone: {out}")
            else:
                self._clear_sticky_hint()
            self.refresh_async(force_mics=True)
            return False

        # --------------------------------------------------------- estado
        def refresh_async(self, force_mics: bool = False) -> None:
            """Atualiza o estado sem bloquear a thread do GTK."""
            if self._refresh_inflight:
                self._refresh_pending = True
                return
            self._refresh_inflight = True
            want_mics = force_mics or not self.mics
            # Um status pedido ANTES de um toggle descreve o estado anterior.
            # A geração viaja com o resultado para que ele não desfaça a
            # intenção do usuário quando chega depois da resposta do toggle.
            generation = self._toggle_seq

            def work() -> None:
                state = control_json("status")
                mics_raw = control("mics")[1] if want_mics else None
                GLib.idle_add(self._on_state, state, mics_raw, want_mics, generation)

            threading.Thread(target=work, daemon=True).start()

        def _on_state(self, state: dict, mics_raw: str | None, want_mics: bool,
                      generation: int | None = None) -> bool:
            self._refresh_inflight = False

            if state:
                self.available = bool(state.get("available"))
                # Enquanto um toggle está em voo, o status pode refletir o
                # valor ANTERIOR à intenção do usuário. Aplicar esse valor
                # aqui fazia a UI voltar atrás no meio do clique duplo (e era
                # a outra metade do bug de "UI diz OFF, servidor ligado").
                # O mesmo vale para um status pedido antes do toggle que
                # chega depois: a geração denuncia que ele é antigo.
                stale = (
                    self._toggle_inflight > 0
                    or (generation is not None and generation != self._toggle_seq)
                )
                if not stale:
                    self.enabled = bool(state.get("enabled"))
                self.mic = state.get("mic") or ""
                if state.get("intensity") is not None:
                    self.intensity = float(state["intensity"])
                    self._syncing = True
                    try:
                        self.intensity_scale.set_value(self.intensity)
                    finally:
                        self._syncing = False
                    self.intensity_value.set_text(f"{int(self.intensity * 100)}%")
                self.switch.set_sensitive(self.available)
                # set_active() dispara 'state-set'; sem a guarda isso reenvia
                # o toggle ao servidor a cada refresh.
                self._syncing = True
                try:
                    self.switch.set_active(self.enabled)
                    # mantém o desenho (:checked) alinhado ao estado real
                    self.switch.set_state(self.enabled)
                finally:
                    self._syncing = False
                self._render_state()

                sticky = getattr(self, "_sticky_hint", "")
                if self.available and not state.get("source_connected", True):
                    self.hint.set_text("Reconectando o microfone…")
                    threading.Thread(target=self._reconnect_worker, daemon=True).start()
                elif sticky:
                    self.hint.set_text(sticky)
                elif self.available:
                    # Não apagar o aviso de "sem bandeja": ele é a única
                    # explicação de por que a janela abriu sozinha.
                    self.hint.set_text(getattr(self, "_no_tray_notice", ""))
                else:
                    self.hint.set_text(
                        "Filtro indisponível. Rode scripts/linux/setup-denoiser.sh."
                    )

            if mics_raw is not None and want_mics:
                self._apply_mics(mics_raw)

            if self.tray:
                self.tray.update_state(self.enabled)

            if self._refresh_pending:
                self._refresh_pending = False
                self.refresh_async()
            return False

        def _reconnect_worker(self) -> None:
            code, _out = control("reconnect")
            if code == 0:
                self.refresh_async()

        def _render_state(self) -> None:
            if self.enabled:
                self.state_label.set_text("ligado — voz limpa")
                self.state_label.get_style_context().remove_class("state-off")
                self.state_label.get_style_context().add_class("state-on")
            else:
                self.state_label.set_text("desligado — áudio original")
                self.state_label.get_style_context().remove_class("state-on")
                self.state_label.get_style_context().add_class("state-off")

        def _apply_mics(self, out: str) -> None:
            entries: list[tuple[str, str]] = []
            for line in out.splitlines():
                line = line.rstrip("\n")
                if not line.strip() or "\t" not in line:
                    continue
                line = line.strip()
                line = line[2:] if line.startswith("* ") else line
                line = line.strip()
                name, desc = line.split("\t", 1)
                entries.append((name.strip(), desc.strip()))
            if not entries:
                return
            self.mics = entries
            self._syncing = True
            try:
                self.mic_combo.remove_all()
                for _name, desc in entries:
                    self.mic_combo.append_text(desc)
                for i, (name, _desc) in enumerate(entries):
                    if name == self.mic:
                        self.mic_combo.set_active(i)
                        break
                else:
                    self.mic_combo.set_active(0)
            finally:
                self._syncing = False

        # -------------------------------------------------------- medidor
        def _start_level_stream(self) -> None:
            """Lê o nível de um único pw-cat contínuo (não um processo por amostra)."""
            self._level_thread = threading.Thread(
                target=self._level_worker, daemon=True
            )
            self._level_thread.start()

        def _level_worker(self) -> None:
            failures = 0
            while not self._closing:
                try:
                    # start_new_session=True: o controlador e o pw-cat que ele
                    # cria ficam num grupo próprio. Fechar o app pode então
                    # sinalizar o grupo inteiro e não deixar pw-cat órfão
                    # (encerrar só o controlador depende de SIGPIPE para o
                    # neto morrer, o que não é determinístico).
                    proc = subprocess.Popen(
                        [CONTROL, "level-stream"],
                        stdout=subprocess.PIPE,
                        stderr=subprocess.DEVNULL,
                        text=True,
                        bufsize=1,
                        start_new_session=True,
                    )
                except OSError:
                    # Nada de desistir para sempre: backoff e nova tentativa.
                    failures += 1
                    GLib.idle_add(
                        self._show_hint,
                        "Medidor indisponível; tentando novamente…",
                    )
                    self._sleep_backoff(failures)
                    continue

                self._level_stream = proc
                assert proc.stdout is not None
                produced = False
                for line in proc.stdout:
                    line = line.strip()
                    if not line:
                        continue
                    # O controlador imprime "ready" quando o stream abre.
                    # Antes ele imprimia 0, que era lido como 0 dBFS (barra no
                    # máximo) a cada (re)início do stream.
                    if line == "ready":
                        continue
                    try:
                        db = float(line)
                    except ValueError:
                        continue
                    produced = True
                    self._last_level = db
                    GLib.idle_add(self._on_level, db)
                try:
                    proc.wait(timeout=1)
                except subprocess.TimeoutExpired:
                    proc.kill()

                if self._closing:
                    break
                if produced:
                    failures = 0
                else:
                    # pw-cat saiu sem produzir nada (nó ausente?). Sem backoff
                    # isso virava um par control+pw-cat por segundo, para
                    # sempre.
                    failures += 1
                self._sleep_backoff(failures)

        @staticmethod
        def _sleep_backoff(failures: int) -> None:
            import time

            # 1s, 2s, 4s… até 15s — rápido para recuperar de um restart do
            # PipeWire, lento para não consumir CPU num ambiente quebrado.
            # `2 ** n` estoura para n grande (OverflowError mata a thread do
            # medidor para sempre); o teto vem antes da exponenciação.
            exponent = min(max(0, failures - 1), 4)
            time.sleep(min(15.0, float(2 ** exponent)))

        def _stop_level_stream(self) -> None:
            proc = self._level_stream
            if proc is None:
                return
            self._level_stream = None
            try:
                if proc.poll() is None:
                    os.killpg(proc.pid, signal.SIGTERM)
            except (ProcessLookupError, PermissionError, OSError):
                try:
                    proc.terminate()
                except OSError:
                    pass
            try:
                proc.wait(timeout=1.5)
            except subprocess.TimeoutExpired:
                try:
                    os.killpg(proc.pid, signal.SIGKILL)
                except (ProcessLookupError, PermissionError, OSError):
                    try:
                        proc.kill()
                    except OSError:
                        pass

        def _on_level(self, db: float) -> bool:
            # -60..0 dBFS -> 0..1
            frac = (max(-60.0, min(0.0, db)) + 60.0) / 60.0
            self.level_bar.set_value(frac)
            if db <= -59.0:
                self.level_value.set_text("—")
            else:
                self.level_value.set_text(f"{db:.0f} dB")
            return False

        # --------------------------------------------------- configurações
        def open_settings(self) -> None:
            if self._settings_win is not None:
                self._settings_win.present()
                return

            win = Gtk.Window(title="nvclean — configurações")
            win.set_transient_for(self.window)
            win.set_default_size(400, -1)
            win.set_resizable(False)
            win.get_style_context().add_class("settings")
            outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14)
            outer.set_border_width(20)
            win.add(outer)

            title = Gtk.Label(label="Configurações", xalign=0)
            title.get_style_context().add_class("title")
            outer.pack_start(title, False, False, 0)

            start_check = Gtk.CheckButton(
                label="Iniciar junto com o sistema (só na bandeja)"
            )
            start_check.set_active(autostart_installed())
            outer.pack_start(start_check, False, False, 0)

            bg_check = Gtk.CheckButton(
                label="Continuar em segundo plano ao fechar a janela"
            )
            bg_check.set_active(bool(self.settings.get("stay_in_background", True)))
            outer.pack_start(bg_check, False, False, 0)

            hint = Gtk.Label(label="", xalign=0)
            hint.get_style_context().add_class("subtitle")
            hint.set_line_wrap(True)
            hint.set_max_width_chars(44)
            outer.pack_start(hint, False, False, 0)

            row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
            row.set_halign(Gtk.Align.END)
            quit_btn = Gtk.Button(label="Sair agora")
            quit_btn.connect("clicked", lambda *_: self.quit())
            close_btn = Gtk.Button(label="Fechar")
            close_btn.connect("clicked", lambda *_: win.close())
            row.pack_start(quit_btn, False, False, 0)
            row.pack_start(close_btn, False, False, 0)
            outer.pack_start(row, False, False, 0)

            def on_start(toggle) -> None:
                # Guarda: reverter o CheckButton emite 'toggled' de novo. Sem
                # isso, uma falha de escrita (disco cheio / ~/.config somente
                # leitura) reentrava em on_start indefinidamente.
                if getattr(on_start, "busy", False):
                    return
                enabled = toggle.get_active()
                on_start.busy = True
                try:
                    if apply_autostart(enabled):
                        self.settings["start_with_system"] = enabled
                        save_settings(self.settings)
                        hint.set_text(
                            "Autostart ativado." if enabled else "Autostart desativado."
                        )
                    else:
                        toggle.set_active(not enabled)
                        hint.set_text(
                            "Não foi possível alterar o autostart "
                            "(verifique ~/.config/autostart)."
                        )
                finally:
                    on_start.busy = False

            def on_background(toggle) -> None:
                self.settings["stay_in_background"] = toggle.get_active()
                save_settings(self.settings)
                hint.set_text(
                    "A janela continuará na bandeja ao fechar."
                    if toggle.get_active()
                    else "Fechar a janela encerrará o app."
                )

            start_check.connect("toggled", on_start)
            bg_check.connect("toggled", on_background)
            win.connect("destroy", lambda *_: setattr(self, "_settings_win", None))
            self._settings_win = win
            win.show_all()

        # --------------------------------------------------- ciclo de vida
        def _on_close(self, *_args) -> bool:
            if self.settings.get("stay_in_background", True):
                self.window.hide()
                return True
            # preferência: fechar de vez
            self.quit()
            return True

        def quit(self) -> None:
            if self._closing:
                return
            self._closing = True
            self._stop_level_stream()
            Gtk.main_quit()

    # Instância única: com a bandeja, abrir o .desktop de novo com o app
    # escondido criaria um segundo ícone (e um segundo medidor). O lock impede
    # isso e, se já houver instância, apenas reabre a janela dela.
    #
    # Nada de /tmp (world-writable, e `open("w")` segue symlink podendo truncar
    # um arquivo do usuário). Preferência: XDG_RUNTIME_DIR, senão o estado do
    # próprio usuário.
    _lock_dir = os.environ.get("NVCLEAN_LOCK_DIR") or (
        os.environ.get("XDG_RUNTIME_DIR")
        or os.path.join(
            os.environ.get("XDG_STATE_HOME")
            or os.path.expanduser("~/.local/state"),
        )
    )
    # Subpasta propria: $XDG_RUNTIME_DIR/app.lock e generico demais e pode
    # colidir com outro app.
    _lock_dir = os.path.join(_lock_dir, "nvclean")
    _lock_path = os.path.join(_lock_dir, "app.lock")
    _lock_fh = None
    _already_running = False
    try:
        import errno
        import fcntl

        os.makedirs(_lock_dir, exist_ok=True)
        flags = os.O_RDWR | os.O_CREAT | getattr(os, "O_NOFOLLOW", 0)
        _fd = os.open(_lock_path, flags, 0o600)
        _lock_fh = os.fdopen(_fd, "r+", encoding="utf-8")
        try:
            fcntl.flock(_lock_fh, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except OSError as exc:
            # Só EWOULDBLOCK/EAGAIN significam "outra instância". Qualquer
            # outro errno (ENOLCK em NFS/FUSE, EACCES...) quer dizer que o
            # lock NÃO funciona aqui — e aí o app deve abrir normalmente, em
            # vez de sair achando que já existe uma instância.
            if exc.errno in (errno.EWOULDBLOCK, errno.EAGAIN):
                _already_running = True
            else:
                _lock_fh = None
    except (OSError, ImportError):
        # Sem lock disponível (filesystem estranho): não bloqueia o app.
        _lock_fh = None

    if _already_running:
        # já existe: pede para a instância viva abrir a janela e sai.
        try:
            subprocess.run(
                ["gdbus", "call", "--session", "--dest", "org.nvclean.App",
                 "--object-path", "/StatusNotifierItem",
                 "--method", "org.kde.StatusNotifierItem.Activate", "0", "0"],
                capture_output=True, timeout=5,
            )
        except (OSError, subprocess.SubprocessError):
            pass
        return 0

    app = App()
    signal.signal(signal.SIGINT, lambda *_: app.quit())
    signal.signal(signal.SIGTERM, lambda *_: app.quit())
    Gtk.main()
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
